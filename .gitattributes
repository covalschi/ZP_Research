# DayZ-специфіка: парсер stringtable завершує рядки ПО CRLF. Файл із самими LF
# читається як один незавершений рядок-заголовок — жоден ключ не знаходиться, і в грі
# видно сирі #str_*. Тому кінці рядків тут фіксуємо явно, а не віддаємо на розсуд
# core.autocrlf чужої машини.
*.csv text eol=crlf

# Конфіги, скрипти й лейаути движка тримаємо в тому ж вигляді, в якому вони на диску,
# щоб перевіряння балансу дужок і діфи не шуміли переносами.
*.cpp  text eol=crlf
*.hpp  text eol=crlf
*.c    text eol=crlf
*.layout text eol=crlf
*.ps1  text eol=crlf

*.md   text
*.json text

# zp_types.xml мода: у робочому дереві були ЗМІШАНІ кінці рядків (частина рядків LF,
# частина CRLF — слід ручних дописувань), хоча в індексі файл лежить у LF. Без явного
# правила core.autocrlf=true віддавав би робочій копії CRLF, і формат «плив» би між
# машинами й правками. XML рушій розбирає незалежно від кінців рядків (на відміну від
# stringtable.csv, якому CRLF ОБОВ'ЯЗКОВИЙ), тож фіксуємо LF — рівно те, що в git.
*.xml  text eol=lf

# Конфіги стенда — байт-канонічний формат рушія (LF, без BOM, без завершального переносу
# рядка). Правило "*.json text" вище разом із core.autocrlf=true віддало б СВІЖОМУ КЛОНУ
# CRLF, і стенд перестав би бути байт-ідентичним експорту веб-редактора (writeback --dry
# показав би «змінено» на всіх файлах). Той самий прийом, що у
# webeditor/tests/fixtures/.gitattributes для золотих фікстур рушія.
examples/**/*.json text eol=lf

# Бінарники — без нормалізації і без спроб діфати
*.pbo    binary
*.bisign binary
*.bikey  binary
*.paa    binary
*.edds   binary
*.p3d    binary
*.skill  binary
