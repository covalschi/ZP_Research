     size 710 430
     hexactsize 1
     vexactsize 1
     text ""
     "exact text" 1
     "exact text size" 13
     color 0.85 0.85 0.8 1
    }
    // ФОРМА. Полотно всередині прокрутки: рядки розставляє код, тому висота полотна
    // задається в рантаймі, а не тут.
    ScrollWidgetClass FormScroll {
     position 370 110
     hexactpos 1
     vexactpos 1
     size 710 430
     hexactsize 1
     vexactsize 1
     // Ключ зветься саме "Scrollbar V" (так у всіх ванільних розмітках); вигаданого
     // "vertical scroll" рушій не знає, і смуга не з'являлась.
     "Scrollbar V" 1
     "Scrollbar H" 0
     {
      // СІТКА В ОДНУ КОЛОНКУ, а не панель. Висоту вмісту прокрутка бере з дитини, а
      // панелі її задавали ми самі — і SetSize по висоті не спрацьовував, тож вміст
      // назавжди лишався 100 одиниць: прокручувати не було чого, а рядки нижче просто
      // виходили за вікно. Сітка рахує свою висоту сама (Size To Content V).
      // Саме WrapSpacer тут не годиться: із «Size To Content H» він розширюється під
      // вміст і поставив би рядки в один ряд по горизонталі.
      GridSpacerWidgetClass FormContent {
       position 0 0
       hexactpos 1
       vexactpos 1
       size 700 100
       hexactsize 1
       vexactsize 0
       Padding 0
       Margin 0
       Columns 1
       "Size To Content V" 1
      }
     }
    }
