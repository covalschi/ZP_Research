  // ОДИН переносимий віджет замість двох рядків уручну. Перенос вмикає код
  // (SetLineBreakingOverride), і рушій сам вирішує, де ламати назву — тому підпис більше
  // не залежить від того, чи вгадали ми ширину при вимірюванні. Два фіксовані рядки
  // різали все довше двох: «Мутагенні сполуки» ставало «Мутагенн сполуки».
  MultilineTextWidgetClass NodeName {
   visible 1
   ignorepointer 1
   color 0.97 0.97 0.97 1
   position 0.35 0.08
   size 0.62 0.56
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 4
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 12
   "bold text" 1
   // ПЕРЕНОС ВМИКАЄ САМЕ ЦЕЙ КЛЮЧ. Одного SetLineBreakingOverride із коду мало: без
   // «wrap 1» віджет лишається однорядковим і просто обрізає назву — що й було видно
   // («Основи польове» замість «Основи польових досліджень»). Ключ стоїть у всіх
   // ванільних переносимих написах.
   wrap 1
   "text valign" top
  }
