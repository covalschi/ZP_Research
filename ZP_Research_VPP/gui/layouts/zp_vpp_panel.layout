// Вікно вкладки ZP Research усередині VPP AdminTools.
//
// Побудовано за ВЛАСНИМ шаблоном VPP для чужих підменю (gui/layouts/customsubmenu.layout):
// ті самі стилі (DayZDefaultPanelBottom, blank, Editor), той самий порядок Header/HeaderTitle,
// ті самі прапорці одиниць. Так вікно виглядає рідним і поводиться як решта вікон VPP.
//
// ПРАПОРЦІ ОДИНИЦЬ ОБОВ'ЯЗКОВІ ЯВНО. Перша версія цього файлу не оголошувала hexactsize у
// кореневого фрейма — і той схлопнувся майже в точку: усе, що позиціоноване в пікселях,
// намалювалось, а фон і шапка (розтягнуті «на всю ширину вікна») стали нульового розміру.
// Ззовні це виглядало як «текст висить у повітрі без вікна».
FrameWidgetClass rootZpResearch {
 clipchildren 1
 color 0 0 0 0
 size 0.52 0.62
 halign center_ref
 valign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 draggable 0
 {
  SmartPanelWidgetClass Main {
   visible 1
   clipchildren 1
   inheritalpha 0
   color 0 0 0 0.9216
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   scaled 1
   draggable 0
   style DayZDefaultPanelBottom
   "no focus" 0
   {
    TextWidgetClass StatusText {
     ignorepointer 1
     position 0.02 0.07
     size 0.96 0.05
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     text ""
     "text halign" left
     color 0.75 0.80 0.86 1
    }
    ButtonWidgetClass BtnReload {
     position 0.02 0.13
     size 0.26 0.055
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Editor
     text "#str_zp_ui_btn_reload"
     "text halign" center
    }
    MultilineTextWidgetClass InfoText {
     ignorepointer 1
     position 0.02 0.21
     size 0.96 0.72
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     color 0.72 0.76 0.82 1
    }
   }
  }
  PanelWidgetClass Header {
   ignorepointer 0
   size 0.993 0.028
   halign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   draggable 1
   style blank
  }
  SmartPanelWidgetClass HeaderTitle {
   ignorepointer 1
   color 0 0 0 1
   position 0 0
   size 1 0.05
   halign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   scaled 0
   draggable 0
   style DayZDefaultPanelBottom
   {
    TextWidgetClass Title {
     ignorepointer 1
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Bold
     text "#str_zp_ui_vpp_title"
     "text halign" center
     "text valign" center
    }
    ButtonWidgetClass BtnClose {
     clipchildren 1
     color 0 0 0 1
     size 0.04 1
     halign right_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Editor
     text "X"
     "text halign" center
     "text valign" center
    }
   }
  }
 }
}
